{
  "additionalProperties": false,
  "description": "Versioned receipt and tombstone for one disposed conversation root.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "intent_id": {
      "minLength": 1,
      "title": "Intent Id",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    },
    "conversation_key": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Conversation Key",
      "type": "string"
    },
    "conversation_owner_run_id": {
      "minLength": 1,
      "title": "Conversation Owner Run Id",
      "type": "string"
    },
    "store_backend": {
      "enum": [
        "jsonl",
        "sqlite"
      ],
      "title": "Store Backend",
      "type": "string"
    },
    "native_store_layout_version": {
      "const": 1,
      "default": 1,
      "title": "Native Store Layout Version",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "manual",
        "automatic"
      ],
      "title": "Mode",
      "type": "string"
    },
    "definitively_finished_at": {
      "minLength": 1,
      "title": "Definitively Finished At",
      "type": "string"
    },
    "requested_at": {
      "minLength": 1,
      "title": "Requested At",
      "type": "string"
    },
    "status": {
      "const": "deleted",
      "default": "deleted",
      "title": "Status",
      "type": "string"
    },
    "deleted_at": {
      "minLength": 1,
      "title": "Deleted At",
      "type": "string"
    },
    "intent_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "receipt_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Sha256",
      "type": "string"
    }
  },
  "required": [
    "intent_id",
    "receipt_id",
    "conversation_key",
    "conversation_owner_run_id",
    "store_backend",
    "mode",
    "definitively_finished_at",
    "requested_at",
    "deleted_at",
    "intent_sha256",
    "receipt_sha256"
  ],
  "title": "CursorSdkDisposalReceiptV1",
  "type": "object"
}
