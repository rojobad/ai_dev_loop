{
  "$defs": {
    "CursorSdkRecoveryPending": {
      "additionalProperties": false,
      "description": "Durable fence between a failed SDK worker and native reconciliation.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "recovery_key": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Recovery Key",
          "type": "string"
        },
        "source_attempt_id": {
          "minLength": 1,
          "title": "Source Attempt Id",
          "type": "string"
        },
        "source_dispatch_id": {
          "minLength": 1,
          "title": "Source Dispatch Id",
          "type": "string"
        },
        "turn_kind": {
          "enum": [
            "initial",
            "correction"
          ],
          "title": "Turn Kind",
          "type": "string"
        },
        "prompt_path": {
          "minLength": 1,
          "title": "Prompt Path",
          "type": "string"
        },
        "prompt_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "source_journal_path": {
          "minLength": 1,
          "title": "Source Journal Path",
          "type": "string"
        },
        "source_journal_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Journal Sha256",
          "type": "string"
        },
        "native_run_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Run Id"
        },
        "failure_class": {
          "enum": [
            "timeout",
            "capacity",
            "failure",
            "worker_lost",
            "ambiguous"
          ],
          "title": "Failure Class",
          "type": "string"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        }
      },
      "required": [
        "recovery_key",
        "source_attempt_id",
        "source_dispatch_id",
        "turn_kind",
        "prompt_path",
        "prompt_sha256",
        "source_journal_path",
        "source_journal_sha256",
        "failure_class"
      ],
      "title": "CursorSdkRecoveryPending",
      "type": "object"
    },
    "CursorSdkRuntimeBinding": {
      "additionalProperties": false,
      "description": "Durable exact SDK agent/run identity without machine-local private paths.",
      "properties": {
        "schema_version": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "runtime": {
          "const": "sdk-local",
          "default": "sdk-local",
          "title": "Runtime",
          "type": "string"
        },
        "conversation_owner_run_id": {
          "minLength": 1,
          "title": "Conversation Owner Run Id",
          "type": "string"
        },
        "conversation_key": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Conversation Key",
          "type": "string"
        },
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "native_run_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Run Id"
        },
        "identity_artifact_path": {
          "minLength": 1,
          "title": "Identity Artifact Path",
          "type": "string"
        },
        "identity_artifact_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Artifact Sha256",
          "type": "string"
        },
        "latest_journal_path": {
          "minLength": 1,
          "title": "Latest Journal Path",
          "type": "string"
        },
        "latest_journal_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Latest Journal Sha256",
          "type": "string"
        },
        "store_backend": {
          "anyOf": [
            {
              "const": "sqlite",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Store Backend"
        },
        "native_store_layout_version": {
          "anyOf": [
            {
              "const": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Store Layout Version"
        }
      },
      "required": [
        "conversation_owner_run_id",
        "conversation_key",
        "agent_id",
        "identity_artifact_path",
        "identity_artifact_sha256",
        "latest_journal_path",
        "latest_journal_sha256"
      ],
      "title": "CursorSdkRuntimeBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Durable cursor/staging checkpoint carried across Phase 17.4 states.",
  "properties": {
    "iteration": {
      "default": 1,
      "title": "Iteration",
      "type": "integer"
    },
    "chat_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "minLength": 36,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chat Id"
    },
    "chat_artifact_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chat Artifact Path"
    },
    "chat_artifact_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chat Artifact Sha256"
    },
    "original_prompt_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Prompt Path"
    },
    "original_prompt_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Prompt Sha256"
    },
    "continuation_envelope_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Continuation Envelope Path"
    },
    "continuation_envelope_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Continuation Envelope Sha256"
    },
    "usage_limit_fingerprint_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage Limit Fingerprint Path"
    },
    "usage_limit_fingerprint_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage Limit Fingerprint Sha256"
    },
    "cursor_output_fingerprint_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor Output Fingerprint Path"
    },
    "cursor_output_fingerprint_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor Output Fingerprint Sha256"
    },
    "staged_patch_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Staged Patch Path"
    },
    "staged_patch_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Staged Patch Sha256"
    },
    "wait_until": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wait Until"
    },
    "timeout_attempt_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeout Attempt Id"
    },
    "timeout_automatic_retries": {
      "default": 0,
      "maximum": 3,
      "minimum": 0,
      "title": "Timeout Automatic Retries",
      "type": "integer"
    },
    "sdk": {
      "anyOf": [
        {
          "$ref": "#/$defs/CursorSdkRuntimeBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sdk_recovery_pending": {
      "anyOf": [
        {
          "$ref": "#/$defs/CursorSdkRecoveryPending"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "sdk_reconciliation_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sdk Reconciliation Path"
    },
    "sdk_reconciliation_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sdk Reconciliation Sha256"
    }
  },
  "title": "CursorWorkflowCheckpoint",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
