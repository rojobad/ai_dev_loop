{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_dev_loop run state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "project",
    "status",
    "created_at",
    "updated_at",
    "repository",
    "plan",
    "prompt",
    "codex",
    "cursor",
    "workflow",
    "iterations",
    "result",
    "last_error"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "prepared",
        "validating",
        "running_cursor",
        "staging",
        "reviewing",
        "waiting_for_cursor_fix",
        "completed",
        "completed_with_residual_risk",
        "max_iterations_reached",
        "interrupted",
        "failed",
        "aborted",
        "awaiting_bot_review",
        "evaluating_bot_feedback",
        "waiting_for_user_attention",
        "publishing_external_fix"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "git_common_dir",
        "git_dir",
        "branch",
        "initial_head",
        "baseline_status_path"
      ],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "git_common_dir": { "type": "string", "minLength": 1 },
        "git_dir": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "initial_head": { "type": "string", "minLength": 1 },
        "baseline_status_path": { "type": "string", "minLength": 1 }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_path", "snapshot_path", "sha256"],
      "properties": {
        "repository_path": { "type": "string", "minLength": 1 },
        "snapshot_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_repository_path", "snapshot_path", "sha256"],
      "properties": {
        "source_repository_path": { "type": "string", "minLength": 1 },
        "snapshot_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "session_id",
        "session_model",
        "review_model",
        "review_skill",
        "sandbox"
      ],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "session_model": { "type": ["string", "null"] },
        "session_reasoning_effort": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
            },
            { "type": "null" }
          ]
        },
        "review_model": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "review_reasoning_effort": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
            },
            { "type": "null" }
          ]
        },
        "review_model_source": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["session", "explicit", "legacy_inherit"]
            },
            { "type": "null" }
          ]
        },
        "review_reasoning_source": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["session", "explicit", "legacy_inherit"]
            },
            { "type": "null" }
          ]
        },
        "model_family_warning": { "type": ["string", "null"] },
        "review_skill": { "type": "string", "minLength": 1 },
        "sandbox": { "type": "string", "minLength": 1 }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "model",
        "output_format",
        "force",
        "trust_workspace",
        "sandbox",
        "chat_id"
      ],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "output_format": { "type": "string", "minLength": 1 },
        "force": { "type": "boolean" },
        "trust_workspace": { "type": "boolean" },
        "sandbox": { "type": "string", "minLength": 1 },
        "chat_id": { "type": ["string", "null"] }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_review_iterations",
        "current_review_iteration",
        "stage_mode",
        "cursor_timeout_minutes",
        "codex_timeout_minutes"
      ],
      "properties": {
        "max_review_iterations": { "type": "integer", "minimum": 1 },
        "current_review_iteration": { "type": "integer", "minimum": 0 },
        "stage_mode": { "type": "string", "minLength": 1 },
        "cursor_timeout_minutes": { "type": "integer", "minimum": 1 },
        "codex_timeout_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "iterations": { "type": "array" },
    "result": { "type": ["string", "null"] },
    "last_error": { "type": ["string", "null"] },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "controller_session_id"],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "controller_session_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "github_pr_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "lifecycle",
        "cycle_number",
        "max_external_cycles",
        "head_branch",
        "base_branch",
        "bound_head_sha"
      ],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "origin": {
          "type": "string",
          "enum": ["source_run", "independent_pr"],
          "default": "source_run"
        },
        "source_run_id": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "prepared_independent",
            "publishing_initial",
            "awaiting_bot_review",
            "evaluating_bot_feedback",
            "waiting_for_user_attention",
            "fixing_external_feedback",
            "publishing_external_fix",
            "max_external_cycles_reached",
            "completed",
            "failed",
            "aborted",
            "interrupted"
          ]
        },
        "cycle_number": { "type": "integer", "minimum": 1 },
        "max_external_cycles": { "type": "integer", "minimum": 1 },
        "pr_number": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "pr_url": { "type": ["string", "null"] },
        "repository_name_with_owner": { "type": ["string", "null"] },
        "head_branch": { "type": "string", "minLength": 1 },
        "base_branch": { "type": "string", "minLength": 1 },
        "bound_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "request_comment_id": { "type": ["string", "null"] },
        "request_marker": { "type": ["string", "null"] },
        "request_created_at": { "type": ["string", "null"] },
        "eligible_thread_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "processed_thread_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "replied_thread_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "resolved_thread_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "publication_commit_sha": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "staged_patch_sha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        },
        "last_external_result_path": { "type": ["string", "null"] },
        "last_snapshot_path": { "type": ["string", "null"] },
        "continue_comment_id": { "type": ["string", "null"] },
        "worker_outcome": { "type": ["string", "null"] },
        "external_fix_prompt_path": { "type": ["string", "null"] },
        "publication_phase": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["pre_commit", "committed", "pushed", "pr_bound"]
            },
            { "type": "null" }
          ]
        },
        "local_commit_sha": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "expected_remote_sha_before_push": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            { "type": "null" }
          ]
        },
        "publication_remote": { "type": ["string", "null"] },
        "publication_remote_branch": { "type": ["string", "null"] },
        "publication_text_path": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "origin": { "const": "independent_pr" } },
            "required": ["origin"]
          },
          "then": {
            "required": ["pr_number", "repository_name_with_owner"],
            "properties": {
              "source_run_id": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              { "properties": { "origin": { "const": "source_run" } } },
              { "not": { "required": ["origin"] } }
            ]
          },
          "then": {
            "required": ["source_run_id"],
            "properties": {
              "source_run_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_run_id",
        "source_status",
        "source_iteration",
        "recovered_checkpoint",
        "source_staged_patch_sha256",
        "created_at",
        "runtime_migration",
        "reason_code"
      ],
      "properties": {
        "source_run_id": { "type": "string", "minLength": 1 },
        "source_status": { "type": "string", "const": "failed" },
        "source_iteration": { "type": "integer", "minimum": 1 },
        "recovered_checkpoint": {
          "type": "string",
          "enum": ["staging", "reviewing", "process_review", "cursor"]
        },
        "source_staged_patch_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "created_at": { "type": "string", "format": "date-time" },
        "runtime_migration": {
          "type": "string",
          "enum": ["none", "phase9_session_capture"]
        },
        "reason_code": {
          "type": "string",
          "enum": [
            "codex_review_failed",
            "codex_review_result_invalid",
            "codex_review_processing_failed",
            "correction_staging_failed",
            "initial_staging_failed",
            "cursor_usage_limit"
          ]
        },
        "cursor_output_fingerprint_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "previous_staged_patch_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "legacy_cursor_output_adopted": {
          "type": ["boolean", "null"]
        },
        "legacy_cursor_usage_limit_adopted": {
          "type": ["boolean", "null"]
        },
        "source_cursor_model": { "type": ["string", "null"], "minLength": 1 },
        "cursor_model_fallback": { "type": ["string", "null"], "minLength": 1 },
        "source_prompt_path": { "type": ["string", "null"], "minLength": 1 },
        "source_prompt_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "usage_limit_fingerprint_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "usage_limit_fingerprint_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "continuation_envelope_path": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "continuation_envelope_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recovered_checkpoint": { "const": "staging" },
              "reason_code": { "const": "correction_staging_failed" }
            },
            "required": ["recovered_checkpoint", "reason_code"]
          },
          "then": {
            "required": [
              "cursor_output_fingerprint_sha256",
              "previous_staged_patch_sha256"
            ],
            "properties": {
              "reason_code": { "const": "correction_staging_failed" },
              "source_iteration": { "type": "integer", "minimum": 2 },
              "source_staged_patch_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "cursor_output_fingerprint_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "previous_staged_patch_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recovered_checkpoint": { "const": "staging" },
              "reason_code": { "const": "initial_staging_failed" }
            },
            "required": ["recovered_checkpoint", "reason_code"]
          },
          "then": {
            "required": ["cursor_output_fingerprint_sha256"],
            "properties": {
              "reason_code": { "const": "initial_staging_failed" },
              "source_iteration": { "const": 1 },
              "source_staged_patch_sha256": { "type": "null" },
              "previous_staged_patch_sha256": { "type": "null" },
              "legacy_cursor_output_adopted": { "enum": [null, false] },
              "cursor_output_fingerprint_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recovered_checkpoint": {
                "enum": ["reviewing", "process_review"]
              }
            },
            "required": ["recovered_checkpoint"]
          },
          "then": {
            "properties": {
              "source_staged_patch_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": { "recovered_checkpoint": { "const": "cursor" } },
            "required": ["recovered_checkpoint"]
          },
          "then": {
            "required": [
              "source_cursor_model",
              "cursor_model_fallback",
              "source_prompt_path",
              "source_prompt_sha256",
              "usage_limit_fingerprint_sha256",
              "usage_limit_fingerprint_path",
              "continuation_envelope_path",
              "continuation_envelope_sha256"
            ],
            "properties": {
              "reason_code": { "const": "cursor_usage_limit" },
              "source_staged_patch_sha256": { "type": "null" },
              "source_cursor_model": { "type": "string", "minLength": 1 },
              "cursor_model_fallback": { "type": "string", "minLength": 1 },
              "source_prompt_path": { "type": "string", "minLength": 1 },
              "source_prompt_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "usage_limit_fingerprint_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "usage_limit_fingerprint_path": {
                "type": "string",
                "minLength": 1
              },
              "continuation_envelope_path": {
                "type": "string",
                "minLength": 1
              },
              "continuation_envelope_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
