{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-loop.local/schemas/scheduler-sequence-manifest-v3.json",
  "title": "SequenceManifestV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "short_name", "phases"],
  "properties": {
    "schema_version": {"const": 3},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "short_name": {"$ref": "#/$defs/shortName"},
    "phases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "shortName": {
      "type": "string",
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F])\\s*(?=\\S)(?=.{1,35}\\s*$).*\\S\\s*$"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "short_name", "plan_path", "prompt_source_path", "codex"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "short_name": {"$ref": "#/$defs/shortName"},
        "plan_path": {"type": "string", "minLength": 1},
        "prompt_source_path": {"type": "string", "minLength": 1},
        "commit_message": {"type": ["string", "null"]},
        "cursor": {"anyOf": [{"$ref": "#/$defs/cursorOverrides"}, {"type": "null"}]},
        "codex": {"$ref": "#/$defs/codexOverrides"},
        "workflow": {"anyOf": [{"$ref": "#/$defs/workflowOverrides"}, {"type": "null"}]},
        "implementer": {"$ref": "#/$defs/implementerOverrides"}
      }
    },
    "cursorOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "output_format": {"type": ["string", "null"]}
      }
    },
    "codexOverrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_model", "review_reasoning_effort"],
      "properties": {
        "command": {"type": ["string", "null"]},
        "review_model": {"type": "string", "minLength": 1},
        "review_reasoning_effort": {"type": "string", "minLength": 1},
        "review_skill": {"type": ["string", "null"]}
      }
    },
    "workflowOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_review_iterations": {"type": ["integer", "null"], "minimum": 1},
        "cursor_timeout_minutes": {"type": ["integer", "null"], "minimum": 1},
        "codex_timeout_minutes": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "implementerOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["cursor", "codex"]},
        "command": {"type": "string", "pattern": "\\S"},
        "model": {"type": "string", "pattern": "\\S"},
        "reasoning_effort": {"enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
        "timeout_minutes": {"type": "integer", "minimum": 1}
      },
      "allOf": [{
        "if": {"properties": {"provider": {"const": "codex"}}, "required": ["provider"]},
        "else": {"not": {"anyOf": [
          {"required": ["command"]},
          {"required": ["model"]},
          {"required": ["reasoning_effort"]},
          {"required": ["timeout_minutes"]}
        ]}}
      }]
    }
  }
}
