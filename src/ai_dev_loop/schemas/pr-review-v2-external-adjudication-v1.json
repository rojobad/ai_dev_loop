{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_dev_loop PR review v2 external adjudication v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions", "fix_prompt_text"],
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thread_id", "decision", "safe_summary", "reply_body"],
        "properties": {
          "thread_id": { "type": "string", "minLength": 1 },
          "decision": {
            "type": "string",
            "enum": ["actionable", "not_applicable", "uncertain"]
          },
          "safe_summary": { "type": "string", "minLength": 1 },
          "reply_body": {
            "description": "null when decision is actionable; non-empty string when not_applicable or uncertain",
            "type": ["string", "null"]
          }
        }
      }
    },
    "fix_prompt_text": {
      "description": "non-empty string when every decision is actionable; null when any decision is non-actionable",
      "type": ["string", "null"]
    }
  }
}
