{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-loop.local/schemas/integration-api-dashboard-projects-data-v1.json",
  "title": "ai_dev_loop Integration API dashboard project catalog data v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["observedAt", "items", "page", "totalCount"],
  "properties": {
    "observedAt": { "type": "string", "format": "integration-rfc3339-utc" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["projectName", "runCount"],
        "properties": {
          "projectName": { "type": "string", "minLength": 1 },
          "runCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "page": {
      "$ref": "https://ai-dev-loop.local/schemas/integration-api-dashboard-shared-v1.json#/$defs/page"
    },
    "totalCount": { "type": "integer", "minimum": 0 }
  }
}
