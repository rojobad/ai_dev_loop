{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-loop.local/schemas/scheduler-review-prompt-evidence-v1.json",
  "title": "ai_dev_loop scheduler Codex review prompt evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "review_iteration",
    "prompt_path",
    "prompt_sha256",
    "prompt_size_bytes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "review_iteration": { "type": "integer", "minimum": 1 },
    "prompt_path": { "type": "string", "minLength": 1 },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_size_bytes": { "type": "integer", "minimum": 1 }
  }
}
