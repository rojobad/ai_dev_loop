{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-loop.local/schemas/integration-api-dashboard-activity-data-v1.json",
  "title": "ai_dev_loop Integration API dashboard activity data v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["observedAt", "filters", "coverage", "metric", "unit", "days", "total"],
  "properties": {
    "observedAt": { "type": "string", "format": "integration-rfc3339-utc" },
    "filters": {
      "$ref": "https://ai-dev-loop.local/schemas/integration-api-dashboard-shared-v1.json#/$defs/filters"
    },
    "coverage": {
      "$ref": "https://ai-dev-loop.local/schemas/integration-api-dashboard-shared-v1.json#/$defs/coverage"
    },
    "metric": { "enum": ["submissions", "review-rounds", "process-hours"] },
    "unit": { "enum": ["count", "process-seconds"] },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["date", "value"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "value": { "type": "number", "minimum": 0 }
        }
      }
    },
    "total": { "type": "number", "minimum": 0 }
  }
}
