{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_dev_loop project configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "cursor", "codex", "workflow", "prompt"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "model",
        "output_format",
        "force",
        "trust_workspace",
        "sandbox"
      ],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "output_format": {
          "type": "string",
          "enum": ["stream-json", "json", "text"]
        },
        "force": { "type": "boolean" },
        "trust_workspace": { "type": "boolean" },
        "sandbox": {
          "type": "string",
          "enum": ["enabled", "disabled"]
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "review_skill", "sandbox"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "review_model": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "review_reasoning_effort": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"]
            },
            { "type": "null" }
          ]
        },
        "review_skill": { "type": "string", "minLength": 1 },
        "sandbox": {
          "type": "string",
          "enum": ["read-only", "workspace-write", "danger-full-access"]
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_review_iterations",
        "require_clean_worktree",
        "stage_mode",
        "cursor_timeout_minutes",
        "codex_timeout_minutes"
      ],
      "properties": {
        "max_review_iterations": { "type": "integer", "minimum": 1 },
        "require_clean_worktree": { "type": "boolean" },
        "stage_mode": { "type": "string", "enum": ["all"] },
        "cursor_timeout_minutes": { "type": "integer", "minimum": 1 },
        "codex_timeout_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "filename_template"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "filename_template": { "type": "string", "minLength": 1 }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "reviewer_logins": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_trigger_body": { "type": "string", "minLength": 1 },
        "poll_interval_seconds": { "type": "integer", "minimum": 1 },
        "poll_timeout_hours": { "type": "integer", "minimum": 1 },
        "max_external_cycles": { "type": "integer", "minimum": 1 },
        "user_mention": { "type": "string", "minLength": 1 },
        "continue_command": { "type": "string", "minLength": 1 },
        "external_review_skill": { "type": "string", "minLength": 1 },
        "max_local_review_iterations": { "type": "integer", "minimum": 1 },
        "pr_base": { "type": "string", "minLength": 1 },
        "acknowledgement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "reaction": { "type": "string", "minLength": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "on_timeout": { "type": "string", "const": "diagnostic_only" }
          }
        },
        "no_findings_completion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "accepted_comment_prefixes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "reviewed_commit_prefix_length": {
              "type": "integer",
              "minimum": 7,
              "maximum": 40
            }
          }
        }
      }
    },
    "pr_review_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "gh_command": { "type": "string", "minLength": 1 },
        "git_command": { "type": "string", "minLength": 1 },
        "ssh_command": { "type": "string", "minLength": 1 },
        "remote_name": { "type": "string", "minLength": 1 },
        "base_branch": { "type": "string", "minLength": 1 },
        "reviewer_logins": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "review_trigger_body": { "type": "string", "minLength": 1 },
        "user_mention": { "type": "string", "minLength": 1 },
        "external_review_skill": { "type": "string", "minLength": 1 },
        "poll_interval_seconds": { "type": "integer", "minimum": 1 },
        "max_external_cycles": { "type": "integer", "minimum": 1 },
        "max_local_iterations": { "type": "integer", "minimum": 1 },
        "per_call_timeout_seconds": { "type": "integer", "minimum": 1 },
        "overall_timeout_seconds": { "type": "integer", "minimum": 1 },
        "max_pages": { "type": "integer", "minimum": 1 },
        "max_items": { "type": "integer", "minimum": 1 },
        "max_server_directed_wait_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "no_findings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "accepted_comment_prefixes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "reviewed_commit_prefix_length": {
              "type": "integer",
              "minimum": 7,
              "maximum": 40
            }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lease_ttl_seconds": { "type": "integer", "minimum": 1 },
            "heartbeat_interval_seconds": { "type": "integer", "minimum": 1 },
            "idle_poll_seconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
