{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-loop.local/schemas/scheduler-output-observation-v1.json",
  "title": "ai_dev_loop scheduler cursor output observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "iteration",
    "stdout",
    "stderr"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "iteration": { "type": "integer", "minimum": 1 },
    "stdout": { "$ref": "#/$defs/streamObservation" },
    "stderr": { "$ref": "#/$defs/streamObservation" }
  },
  "$defs": {
    "streamObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stored_bytes", "truncated"],
      "properties": {
        "stored_bytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    }
  }
}
