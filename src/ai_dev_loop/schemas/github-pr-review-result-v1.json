{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai_dev_loop GitHub PR review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eligible_thread_ids",
    "thread_decisions",
    "all_actionable",
    "review_markdown",
    "cursor_fix_prompt",
    "tests_status",
    "summary",
    "residual_risk_comment",
    "highest_severity"
  ],
  "properties": {
    "eligible_thread_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "thread_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thread_id", "decision", "inline_reply", "summary"],
        "properties": {
          "thread_id": { "type": "string", "minLength": 1 },
          "decision": {
            "type": "string",
            "enum": ["actionable", "not_applicable", "uncertain"]
          },
          "inline_reply": { "type": ["string", "null"] },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "all_actionable": { "type": "boolean" },
    "review_markdown": { "type": "string", "minLength": 1 },
    "cursor_fix_prompt": { "type": ["string", "null"] },
    "tests_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped_findings_present",
        "blocked_environment",
        "not_applicable"
      ]
    },
    "summary": { "type": "string", "minLength": 1 },
    "residual_risk_comment": { "type": ["string", "null"] },
    "highest_severity": {
      "type": ["string", "null"],
      "enum": ["P0", "P1", "P2", "P3", null]
    }
  }
}
