{
  "additionalProperties": false,
  "description": "Explicit operator retention policy. It is not inferred from directories.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "policy_id": {
      "const": "cursor-sdk-retention",
      "default": "cursor-sdk-retention",
      "title": "Policy Id",
      "type": "string"
    },
    "automatic_cleanup_enabled": {
      "title": "Automatic Cleanup Enabled",
      "type": "boolean"
    },
    "retention_hours": {
