    },
    "decision_source": {
      "const": "operator_2026-10-20",
      "default": "operator_2026-10-20",
      "title": "Decision Source",
      "type": "string"
    },
    "decision_at": {
      "const": "2026-10-20T00:00:00.000000Z",
      "default": "2026-10-20T00:00:00.000000Z",
      "title": "Decision At",
      "type": "string"
    },
    "updated_at": {
      "minLength": 1,
