{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-loop.local/schemas/integration-api-process-output-chunk-v1.json",
  "title": "ai_dev_loop Integration API process output chunk v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "available",
    "reason",
    "encoding",
    "mediaType",
    "byteOffset",
    "returnedBytes",
    "nextOffset",
    "availableBytes",
    "hasMore",
    "contentBase64",
    "sha256",
    "runId",
    "attemptId",
    "component",
    "stream",
    "format",
    "processState",
    "complete",
    "truncatedAtSource",
    "storedBytes"
  ],
  "properties": {
    "available": { "type": "boolean" },
    "reason": { "type": ["string", "null"] },
    "encoding": { "type": "string", "const": "base64" },
    "mediaType": { "type": ["string", "null"] },
    "byteOffset": { "type": "integer", "minimum": 0 },
    "returnedBytes": { "type": "integer", "minimum": 0 },
    "nextOffset": { "type": ["integer", "null"], "minimum": 0 },
    "availableBytes": { "type": ["integer", "null"], "minimum": 0 },
    "hasMore": { "type": "boolean" },
    "contentBase64": { "type": "string" },
    "sha256": { "type": ["string", "null"] },
    "runId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "component": { "type": "string", "minLength": 1 },
    "stream": { "type": "string", "enum": ["stdout", "stderr"] },
    "format": { "type": "string", "enum": ["jsonl", "text"] },
    "processState": { "type": "string", "minLength": 1 },
    "complete": { "type": "boolean" },
    "truncatedAtSource": { "type": ["boolean", "null"] },
    "storedBytes": { "type": ["integer", "null"], "minimum": 0 }
  }
}
