{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "recovery_key",
    "source_run_id",
    "successor_run_id",
    "failed_attempt_id",
    "dispatch_id",
    "status",
    "parent_recovery_key",
    "record_sha256",
    "base_prompt_path",
    "base_prompt_sha256",
    "chat_id",
    "chat_owner_run_id",
    "chat_artifact_path",
    "chat_artifact_sha256",
    "iteration",
    "admitted_artifact_path",
    "admitted_artifact_sha256",
    "plan_sha256",
    "submitted_prompt_sha256",
    "config_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "recovery_key": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "source_run_id": {"minLength": 1, "type": "string"},
    "successor_run_id": {"minLength": 1, "type": "string"},
    "failed_attempt_id": {"minLength": 1, "type": "string"},
    "dispatch_id": {"minLength": 1, "type": "string"},
    "status": {"enum": ["pending", "ready", "cancelled"], "type": "string"},
    "parent_recovery_key": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
    "record_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
    "base_prompt_path": {"minLength": 1, "type": "string"},
    "base_prompt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "chat_id": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "type": "string"
    },
    "chat_owner_run_id": {"minLength": 1, "type": "string"},
    "chat_artifact_path": {"minLength": 1, "type": "string"},
    "chat_artifact_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "iteration": {"minimum": 1, "type": "integer"},
    "admitted_artifact_path": {"minLength": 1, "type": "string"},
    "admitted_artifact_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "plan_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "submitted_prompt_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "config_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "ready"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"record_sha256": {"type": "string"}}
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["pending", "cancelled"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {"record_sha256": {"type": "null"}}
      }
    }
  ]
}
