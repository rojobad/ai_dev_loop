{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-loop.local/schemas/scheduler-submitted-run-context-v7.json",
  "title": "SubmittedRunContextV7",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_name", "repository", "plan_prompt", "effective_config", "codex", "cursor", "workflow", "controller", "implementer"],
  "properties": {
    "schema_version": {"const": 7},
    "project_name": {"type": "string", "minLength": 1},
    "repository": {"$ref": "scheduler-submitted-run-context-v3.json#/$defs/repository_target_binding"},
    "plan_prompt": {"$ref": "scheduler-submitted-run-context-v3.json#/$defs/plan_prompt_binding"},
    "effective_config": {"$ref": "scheduler-submitted-run-context-v3.json#/$defs/effective_config_binding"},
    "codex": {"$ref": "scheduler-submitted-run-context-v3.json#/$defs/fresh_codex_reviewer_binding"},
    "cursor": {"$ref": "#/$defs/sdkCursorBinding"},
    "workflow": {"$ref": "scheduler-submitted-run-context-v3.json#/$defs/workflow_limits"},
    "controller": {"$ref": "scheduler-submitted-run-context-v3.json#/$defs/controller_binding"},
    "implementer": {"$ref": "#/$defs/sdkImplementer"}
  },
  "$defs": {
    "sdkCursorBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "runtime", "sdk_version", "model", "parameters", "credential_ref", "setting_sources", "sandbox", "tool_policy"],
      "properties": {
        "schema_version": {"const": 1}, "runtime": {"const": "sdk-local"}, "sdk_version": {"const": "1.0.37"},
        "model": {"type": "string", "minLength": 1},
        "parameters": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "boolean"]}},
        "credential_ref": {"type": "string", "minLength": 1},
        "setting_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sandbox": {"enum": ["enabled", "disabled"]}, "tool_policy": {"const": "scheduler-owned-no-shell"}
      }
    },
    "sdkImplementer": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "provider", "purpose", "runtime", "model", "reasoning_effort", "timeout_minutes", "sandbox", "approval_policy", "session_id"],
      "properties": {
        "schema_version": {"const": 2}, "provider": {"const": "cursor"}, "purpose": {"const": "implementer"}, "runtime": {"const": "sdk-local"},
        "model": {"type": "string", "minLength": 1}, "reasoning_effort": {"type": "null"}, "timeout_minutes": {"type": "integer", "minimum": 1},
        "sandbox": {"enum": ["enabled", "disabled"]}, "approval_policy": {"type": "null"}, "session_id": {"type": "null"}
      }
    }
  }
}
