{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-loop.local/schemas/scheduler-submitted-state-v1.json",
  "title": "SubmittedState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "version",
    "submitted_at",
    "updated_at",
    "idempotency_key",
    "context"
  ],
  "properties": {
    "kind": { "const": "queued" },
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "submitted_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "context": {
      "oneOf": [
        {
          "$ref": "scheduler-submitted-run-context-v1.json"
        },
        {
          "$ref": "scheduler-submitted-run-context-v2.json"
        }
      ]
    }
  }
}
